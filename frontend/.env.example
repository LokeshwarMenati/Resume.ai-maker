# Copy to frontend/.env — Vite only exposes variables prefixed with VITE_.
# Restart `npm run dev` after changes (hot reload does not reload .env).

# Use proxy in dev — leave blank to use vite.config proxy → localhost:5000
VITE_API_URL=

# Same OAuth 2.0 Web client ID as GOOGLE_CLIENT_ID in backend/.env
VITE_GOOGLE_CLIENT_ID=

# Optional: set to "true" if the Google button fails in Chrome (FedCM / third-party cookie phase-out).
# VITE_GOOGLE_USE_FEDCM=true
