# Copy to backend/.env — loaded only from this folder (see resume-builder/.env.example).

PORT=5000

# Atlas example (preferred for quick remote DB):
# MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/resume_builder?retryWrites=true&w=majority

# Local MongoDB / Docker:
MONGO_URI=mongodb://127.0.0.1:27017/resume_builder

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
OPENAI_API_KEY=sk-your-openai-api-key

# Google Sign-In (OAuth 2.0 Web client ID). Must match frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

